# Copy to terraform.tfvars for local runs or override via TF_VAR_* in CI.
# Never put sql_user_password or api_token in any .tfvars file; both are ephemeral
# write-only inputs prompted interactively by Terraform at apply time (or supplied via
# TF_VAR_sql_user_password / TF_VAR_api_token) and omitted from saved plans and state.
# sql_user_password sets both the Cloud SQL appuser password and the db-password secret
# version; to rotate either secret, update its value and increment its *_version counter.

# Core & Application
gcp_project_id     = "lightbulb-90616"
gcp_region         = "europe-west1"
app_candidate_name = "Erez Carmeli"
cloudrun_image_tag = "a1b2c3d"

# Network CIDRs
network_subnet_cidr       = "10.10.0.0/24"
network_psa_address       = "10.20.0.0"
network_psa_prefix_length = 24

# Cloud SQL & Secrets (PoC vs. Prod Toggles & Rotation Versions)
sql_tier                  = "db-f1-micro"
sql_availability_type     = "ZONAL"
sql_backup_enabled        = false
sql_deletion_protection   = false
sql_user_password_version = 1
api_token_version         = 1

# Cloud Run (PoC vs. Prod Toggles & Scaling)
cloudrun_ingress               = "INGRESS_TRAFFIC_ALL"
cloudrun_min_instances         = 0
cloudrun_max_instances         = 2
cloudrun_deletion_protection   = false
cloudrun_allow_unauthenticated = true
